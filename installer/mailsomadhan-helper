#!/usr/bin/env bash
#
# Privileged helper for the MailSomadhan panel.
#
# The panel API runs as the unprivileged user "mailsomadhan" and may only run this script through
# sudo. Every argument is validated here and nothing from the caller is ever evaluated, so a
# compromised panel process cannot turn this into a root shell.
#
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 022

CONF=/etc/mailsomadhan/helper.conf          # MAIL_HOSTNAME, WEB_PORT (root-owned)
HOSTS_FILE=/var/lib/mailsomadhan/hosts.txt  # written by the panel: treat as untrusted input
TLS_DIR=/etc/mailsomadhan/tls
ACME_ROOT=/var/www/mailsomadhan-acme
MAIL_DIR=/var/vmail

# shellcheck disable=SC1090
. "$CONF"
HTTP_PORT="${HTTP_PORT:-80}"

HOST_RE='^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$'
EMAIL_RE='^[a-z0-9][a-z0-9._+-]{0,63}@([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$'

die() { echo "error: $*" >&2; exit 1; }

valid_host() { [ "${#1}" -le 253 ] && [[ "$1" =~ $HOST_RE ]]; }

list_hosts() {
  [ -f "$HOSTS_FILE" ] || return 0
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    if valid_host "$line"; then echo "$line"; fi
  done < <(head -n 500 "$HOSTS_FILE")
}

reload_services() {
  if nginx -t >/dev/null 2>&1; then
    systemctl reload nginx 2>/dev/null || systemctl restart nginx 2>/dev/null || true
  else
    echo "warning: nginx configuration test failed" >&2
    nginx -t >&2 || true
  fi
  systemctl reload postfix 2>/dev/null || true
  systemctl reload dovecot 2>/dev/null || true
}

# Rebuild the per-host TLS configuration (nginx vhosts, Postfix SNI map, Dovecot local_name).
sync_tls() {
  local sni dov ngx host dir v6=""
  sni="$(mktemp)"; dov="$(mktemp)"; ngx="$(mktemp)"
  # Listen on IPv6 only when it is really usable (many VPS images disable it with sysctl).
  if [ "$(cat /proc/sys/net/ipv6/conf/all/disable_ipv6 2>/dev/null)" = 0 ] &&
     python3 -c 'import socket; socket.socket(socket.AF_INET6).bind(("::", 0))' 2>/dev/null; then
    v6=1
  fi

  {
    echo "# Generated by mailsomadhan-helper - do not edit"
    echo "server {"
    echo "    listen $HTTP_PORT default_server;"
    [ -n "$v6" ] && echo "    listen [::]:$HTTP_PORT default_server;"
    echo "    server_name _;"
    echo "    location ^~ /.well-known/acme-challenge/ { root $ACME_ROOT; default_type text/plain; }"
    echo "    location / { return 301 https://\$host:$WEB_PORT\$request_uri; }"
    echo "}"
    echo "server {"
    echo "    listen $WEB_PORT ssl default_server;"
    [ -n "$v6" ] && echo "    listen [::]:$WEB_PORT ssl default_server;"
    echo "    server_name _;"
    echo "    ssl_certificate     $TLS_DIR/$MAIL_HOSTNAME/fullchain.pem;"
    echo "    ssl_certificate_key $TLS_DIR/$MAIL_HOSTNAME/privkey.pem;"
    echo "    include /etc/nginx/snippets/mailsomadhan-app.conf;"
    echo "}"
  } > "$ngx"
  echo "# Generated by mailsomadhan-helper - do not edit" > "$dov"

  while IFS= read -r host; do
    dir="$TLS_DIR/$host"
    if [ -f "/etc/letsencrypt/live/$host/fullchain.pem" ]; then
      install -d -m 755 "$dir"
      install -m 644 "/etc/letsencrypt/live/$host/fullchain.pem" "$dir/fullchain.pem"
      install -m 600 "/etc/letsencrypt/live/$host/privkey.pem" "$dir/privkey.pem"
    fi
    [ -f "$dir/fullchain.pem" ] && [ -f "$dir/privkey.pem" ] || continue
    [ "$host" = "$MAIL_HOSTNAME" ] && continue   # the primary host is the default certificate

    echo "$host $dir/privkey.pem $dir/fullchain.pem" >> "$sni"
    {
      echo "local_name $host {"
      echo "  ssl_cert = <$dir/fullchain.pem"
      echo "  ssl_key = <$dir/privkey.pem"
      echo "}"
    } >> "$dov"
    {
      echo "server {"
      echo "    listen $WEB_PORT ssl;"
      [ -n "$v6" ] && echo "    listen [::]:$WEB_PORT ssl;"
      echo "    server_name $host;"
      echo "    ssl_certificate     $dir/fullchain.pem;"
      echo "    ssl_certificate_key $dir/privkey.pem;"
      echo "    include /etc/nginx/snippets/mailsomadhan-app.conf;"
      echo "}"
    } >> "$ngx"
  done < <(list_hosts)

  install -m 600 "$sni" /etc/postfix/mailsomadhan_sni
  postmap -F hash:/etc/postfix/mailsomadhan_sni
  install -m 644 "$dov" /etc/dovecot/mailsomadhan-sni.conf
  install -m 644 "$ngx" /etc/nginx/conf.d/mailsomadhan.conf
  rm -f "$sni" "$dov" "$ngx"
  reload_services
}

# ----------------------------------------------------------------------------- features
# Spam filter and Redis switches. The file is written only by this script (values validated),
# so it is safe to source.
FEATURES=/etc/mailsomadhan/features.conf
NUM_RE='^[0-9]{1,3}(\.[0-9]{1,2})?$'

load_features() {
  SPAM_FILTER=1; REDIS=1; GREYLIST=1; JUNK_SCORE=6; REJECT_SCORE=15; TRACK_SUBJECTS=0
  # shellcheck disable=SC1090
  if [ -f "$FEATURES" ]; then . "$FEATURES"; fi
  [[ "$SPAM_FILTER" =~ ^[01]$ ]] || SPAM_FILTER=1
  [[ "$REDIS" =~ ^[01]$ ]] || REDIS=1
  [[ "$GREYLIST" =~ ^[01]$ ]] || GREYLIST=1
  [[ "$JUNK_SCORE" =~ $NUM_RE ]] || JUNK_SCORE=6
  [[ "$REJECT_SCORE" =~ $NUM_RE ]] || REJECT_SCORE=15
  [[ "$TRACK_SUBJECTS" =~ ^[01]$ ]] || TRACK_SUBJECTS=0
}

save_features() {
  local tmp
  tmp="$(mktemp)"
  cat > "$tmp" <<EOF
# Managed by the MailSomadhan panel (Spam filter page). Do not edit by hand.
SPAM_FILTER=$SPAM_FILTER
REDIS=$REDIS
GREYLIST=$GREYLIST
JUNK_SCORE=$JUNK_SCORE
REJECT_SCORE=$REJECT_SCORE
TRACK_SUBJECTS=$TRACK_SUBJECTS
EOF
  install -m 644 "$tmp" "$FEATURES"
  rm -f "$tmp"
}

apply_features() {
  load_features
  local ld=/etc/rspamd/local.d greylist_score

  if [ "$REDIS" = 1 ]; then
    echo 'servers = "127.0.0.1";' > "$ld/redis.conf"
    printf 'backend = "redis";\nautolearn = true;\n' > "$ld/classifier-bayes.conf"
    systemctl enable -q redis-server 2>/dev/null || true
    systemctl start redis-server
  else
    echo '# Redis is turned off in the MailSomadhan panel.' > "$ld/redis.conf"
    echo 'enabled = false;' > "$ld/classifier-bayes.conf"
    systemctl disable -q --now redis-server 2>/dev/null || true
  fi

  if [ "$SPAM_FILTER" = 1 ]; then
    greylist_score=null
    if [ "$REDIS" = 1 ] && [ "$GREYLIST" = 1 ]; then
      greylist_score="$(awk -v j="$JUNK_SCORE" 'BEGIN { g = (j > 5) ? 4 : j - 1; if (g <= 0) print "null"; else print g }')"
    fi
    cat > "$ld/actions.conf" <<EOF
reject = $REJECT_SCORE;
add_header = $JUNK_SCORE;
greylist = $greylist_score;
rewrite_subject = null;
EOF
  else
    # Outgoing mail still passes Rspamd for DKIM signing, but nothing is ever blocked or marked.
    cat > "$ld/actions.conf" <<'EOF'
reject = null;
add_header = null;
greylist = null;
rewrite_subject = null;
EOF
  fi

  # Subjects in the message log (privacy switch on the Message log page).
  if [ "$TRACK_SUBJECTS" = 1 ]; then
    echo '/^Subject:/ INFO' > /etc/postfix/mailsomadhan_header_checks
  else
    : > /etc/postfix/mailsomadhan_header_checks
  fi
  postconf -e "header_checks = regexp:/etc/postfix/mailsomadhan_header_checks"
  sync_milter

  rspamadm configtest >/dev/null || die "rspamd configuration test failed"
  systemctl restart rspamd
  # Wait until Rspamd answers again, so no mail slips through unscanned while it restarts.
  local i
  for i in $(seq 1 40); do
    if rspamc -P "$(. /etc/mailsomadhan/install.conf >/dev/null 2>&1; echo "${RSPAMD_PASS:-}")" stat >/dev/null 2>&1        && ss -ltn | grep -q ':11332 '; then break; fi
    sleep 0.5
  done
  systemctl reload postfix 2>/dev/null || true
}

# Incoming mail on port 25 passes Rspamd while the spam filter is on, or while admin mail
# filter rules exist (with the filter off, score-based actions are disabled but rules still apply).
MAPS_DIR=/var/lib/mailsomadhan/maps
sync_milter() {
  load_features
  local need=0
  [ "$SPAM_FILTER" = 1 ] && need=1
  if [ -d "$MAPS_DIR" ] && find "$MAPS_DIR" -maxdepth 1 -name '*.map' -size +0 | grep -q .; then need=1; fi
  if [ "$need" = 1 ]; then
    postconf -e "smtpd_milters = inet:127.0.0.1:11332"
  else
    postconf -e "smtpd_milters ="
  fi
  systemctl reload postfix 2>/dev/null || true
}

# ----------------------------------------------------------------------------- updates
SRC=/opt/mailsomadhan/src
CACHE=/var/cache/mailsomadhan/repo
UPDATE_LOG=/var/log/mailsomadhan-update.log
STATUS_DIR=/var/lib/mailsomadhan-status   # root-only: never write root files into the panel's own dir
install -d -o root -g root -m 755 "$STATUS_DIR"
RESULT=$STATUS_DIR/update-result.json
VERSION_JSON=$STATUS_DIR/version.json
REPO_URL="${REPO_URL:-https://github.com/mdatiqmazumder/MailSomadhan.git}"
BRANCH="${BRANCH:-main}"
[[ "$REPO_URL" =~ ^(https://|file:///)[A-Za-z0-9._~/-]+$ ]] || die "invalid repository URL in $CONF"
[[ "$BRANCH" =~ ^[A-Za-z0-9._/-]{1,100}$ ]] || die "invalid branch in $CONF"
export GIT_TERMINAL_PROMPT=0

write_result() { # write_result <status> <message>
  python3 - "$RESULT" "$1" "$2" <<'PY'
import datetime, json, os, sys
path, status, message = sys.argv[1:4]
data = {"status": status, "message": message,
        "time": datetime.datetime.now(datetime.timezone.utc).isoformat()}
tmp = path + ".tmp"
with open(tmp, "w") as fh:
    json.dump(data, fh)
os.chmod(tmp, 0o644)
os.replace(tmp, path)
PY
}

TLS_JOB=$STATUS_DIR/tls-job.json
TLS_FLAG=$STATUS_DIR/tls-continue
TLS_LOG=/var/log/mailsomadhan-tls.log
CF_INI=/etc/mailsomadhan/cloudflare.ini
CF_STATE=$STATUS_DIR/cloudflare.json

tls_state() { # tls_state key=value ... -> merged into the certificate job status file
  python3 - "$TLS_JOB" "$@" <<'PY'
import datetime, json, os, sys
path, pairs = sys.argv[1], sys.argv[2:]
try:
    data = json.load(open(path))
except Exception:
    data = {}
for pair in pairs:
    k, _, v = pair.partition("=")
    data[k] = v
data["time"] = datetime.datetime.now(datetime.timezone.utc).isoformat()
tmp = path + ".tmp"
with open(tmp, "w") as fh:
    json.dump(data, fh)
os.chmod(tmp, 0o644)
os.replace(tmp, path)
PY
}

update_check() {
  mkdir -p "$(dirname "$CACHE")"
  if [ -d "$CACHE/.git" ]; then
    git -C "$CACHE" remote set-url origin "$REPO_URL"
    git -C "$CACHE" fetch -q --depth 50 origin "$BRANCH"
    git -C "$CACHE" reset -q --hard FETCH_HEAD
  else
    rm -rf "$CACHE"
    git clone -q --depth 50 --branch "$BRANCH" "$REPO_URL" "$CACHE"
  fi
  python3 - "$CACHE" "$VERSION_JSON" "$STATUS_DIR/update-check.json" <<'PY'
import datetime, json, os, subprocess, sys
cache, version_json, out_path = sys.argv[1:4]
def git(*args):
    return subprocess.run(["git", "-C", cache, *args], capture_output=True, text=True).stdout
installed = {}
try:
    installed = json.load(open(version_json))
except Exception:
    pass
commits = []
for line in git("log", "-n", "50", "--format=%H%x1f%cI%x1f%s").splitlines():
    sha, date, subject = line.split("\x1f", 2)
    commits.append({"commit": sha, "date": date, "subject": subject})
current = installed.get("commit", "")
changes, found = [], False
for c in commits:
    if c["commit"] == current:
        found = True
        break
    changes.append(c)
latest = commits[0] if commits else {}
result = {
    "latest_version": git("show", "HEAD:VERSION").strip(),
    "latest_commit": latest.get("commit", ""),
    "latest_date": latest.get("date", ""),
    "update_available": bool(latest) and latest.get("commit") != current,
    "changes": changes[:30],
    "changes_complete": found,
    "checked_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
}
# Kept for the panel's "update available" notice (refreshed by mailsomadhan-update-check.timer).
tmp = out_path + ".tmp"
with open(tmp, "w") as fh:
    json.dump(result, fh)
os.chmod(tmp, 0o644)
os.replace(tmp, out_path)
print(json.dumps(result))
PY
}

# Runs detached (systemd-run), because it restarts the panel that started it.
update_worker() {
  local prev="" old_tree=""
  write_result running "Update in progress"
  echo "== MailSomadhan update started $(date -Is)"
  echo "== source: $REPO_URL ($BRANCH)"

  if [ -d "$SRC/.git" ]; then
    prev="$(git -C "$SRC" rev-parse HEAD)"
    git -C "$SRC" remote set-url origin "$REPO_URL"
    if ! git -C "$SRC" fetch --depth 1 origin "$BRANCH"; then
      write_result failed "Could not download the update (is the repository public and reachable?)"
      return 1
    fi
    git -C "$SRC" reset --hard FETCH_HEAD
    git -C "$SRC" clean -fdq
  else
    # Installed from a local copy: switch to a git checkout so future updates are incremental.
    old_tree="$SRC.previous"
    rm -rf "$SRC.new" "$old_tree"
    if ! git clone --depth 1 --branch "$BRANCH" "$REPO_URL" "$SRC.new"; then
      write_result failed "Could not download the update (is the repository public and reachable?)"
      return 1
    fi
    mv "$SRC" "$old_tree"
    mv "$SRC.new" "$SRC"
  fi
  echo "== now at $(git -C "$SRC" rev-parse --short HEAD) (version $(cat "$SRC/VERSION" 2>/dev/null || echo '?'))"

  if bash "$SRC/installer/setup.sh"; then
    rm -rf "$old_tree"
    write_result success "Updated to version $(cat "$SRC/VERSION" 2>/dev/null || echo '?')"
    echo "== update finished successfully"
    return 0
  fi

  echo "== update FAILED, restoring the previous version"
  if [ -n "$prev" ]; then
    git -C "$SRC" reset --hard "$prev"
  elif [ -n "$old_tree" ] && [ -d "$old_tree" ]; then
    rm -rf "$SRC"
    mv "$old_tree" "$SRC"
  fi
  if bash "$SRC/installer/setup.sh"; then
    write_result rolled_back "The update failed and the previous version was restored. See the update log."
  else
    write_result failed "The update failed and restoring the previous version also failed. See the update log."
  fi
  return 1
}

# ----------------------------------------------------------------------------- backups
# Encrypted backups to Google Drive through rclone. Secrets (Drive token, passphrase) are
# root-only files; the panel only ever sees the non-secret summary in backup-settings.json.
BACKUP_CONF=/etc/mailsomadhan/backup.conf
RCLONE_CONF=/etc/mailsomadhan/rclone.conf
BACKUP_KEY=/etc/mailsomadhan/backup.key
GDRIVE_SA=/etc/mailsomadhan/gdrive-service-account.json
BACKUP_LOG=/var/log/mailsomadhan-backup.log
BACKUP_STATUS=/var/lib/mailsomadhan-status/backup-status.json
BACKUP_PUBLIC=/var/lib/mailsomadhan-status/backup-settings.json
BACKUP_INTERVALS=" 1 2 3 4 6 8 12 24 168 "

load_backup() {
  BK_ENABLED=0; BK_INTERVAL=24; BK_HOUR=2; BK_KEEP=14; BK_MAIL=1; BK_FOLDER="MailSomadhan-Backups"; BK_MODE=""
  # shellcheck disable=SC1090
  if [ -f "$BACKUP_CONF" ]; then . "$BACKUP_CONF"; fi
  [[ "$BK_ENABLED" =~ ^[01]$ ]] || BK_ENABLED=0
  [[ "$BACKUP_INTERVALS" == *" $BK_INTERVAL "* ]] || BK_INTERVAL=24
  [[ "$BK_HOUR" =~ ^([0-9]|1[0-9]|2[0-3])$ ]] || BK_HOUR=2
  [[ "$BK_KEEP" =~ ^[0-9]{1,3}$ ]] && [ "$BK_KEEP" -ge 1 ] || BK_KEEP=14
  [[ "$BK_MAIL" =~ ^[01]$ ]] || BK_MAIL=1
  [[ "$BK_FOLDER" =~ ^[A-Za-z0-9._-]{1,100}$ ]] || BK_FOLDER="MailSomadhan-Backups"
  [[ "$BK_MODE" =~ ^(|oauth|service_account)$ ]] || BK_MODE=""
}

save_backup() {
  local tmp
  tmp="$(mktemp)"
  cat > "$tmp" <<EOF
# Managed by the MailSomadhan panel (Backups page).
BK_ENABLED=$BK_ENABLED
BK_INTERVAL=$BK_INTERVAL
BK_HOUR=$BK_HOUR
BK_KEEP=$BK_KEEP
BK_MAIL=$BK_MAIL
BK_FOLDER=$BK_FOLDER
BK_MODE=$BK_MODE
EOF
  install -m 600 "$tmp" "$BACKUP_CONF"
  rm -f "$tmp"
  local key_set=false
  [ -s "$BACKUP_KEY" ] && key_set=true
  python3 - "$BACKUP_PUBLIC" <<EOF
import json, os, sys
data = {"enabled": $( [ "$BK_ENABLED" = 1 ] && echo True || echo False ), "interval_hours": $BK_INTERVAL,
        "hour": $BK_HOUR, "keep": $BK_KEEP, "include_mail": $( [ "$BK_MAIL" = 1 ] && echo True || echo False ),
        "folder": "$BK_FOLDER", "mode": "$BK_MODE", "connected": $( [ -s "$RCLONE_CONF" ] && echo True || echo False ),
        "passphrase_set": $( [ "$key_set" = true ] && echo True || echo False )}
tmp = sys.argv[1] + ".tmp"
with open(tmp, "w") as fh:
    json.dump(data, fh)
os.chmod(tmp, 0o644)
os.replace(tmp, sys.argv[1])
EOF
}

write_backup_timer() {
  local cal
  if [ "$BK_INTERVAL" -lt 24 ]; then
    cal="*-*-* 0/$BK_INTERVAL:00:00"
  elif [ "$BK_INTERVAL" = 24 ]; then
    cal="*-*-* $(printf '%02d' "$BK_HOUR"):00:00"
  else
    cal="Sun *-*-* $(printf '%02d' "$BK_HOUR"):00:00"
  fi
  cat > /etc/systemd/system/mailsomadhan-backup.service <<'EOF'
[Unit]
Description=MailSomadhan backup to Google Drive
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=/usr/local/sbin/mailsomadhan-helper backup-worker
Nice=10
IOSchedulingClass=idle
EOF
  cat > /etc/systemd/system/mailsomadhan-backup.timer <<EOF
[Unit]
Description=Scheduled MailSomadhan backup

[Timer]
OnCalendar=$cal
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
EOF
  systemctl daemon-reload
  if [ "$BK_ENABLED" = 1 ]; then
    systemctl enable -q --now mailsomadhan-backup.timer
    systemctl restart mailsomadhan-backup.timer
  else
    systemctl disable -q --now mailsomadhan-backup.timer 2>/dev/null || true
  fi
}

backup_status() { # backup_status <status> <message> [file] [bytes] [seconds]
  python3 - "$BACKUP_STATUS" "$1" "$2" "${3:-}" "${4:-0}" "${5:-0}" <<'PY'
import datetime, json, os, sys
path, status, message, name, size, secs = sys.argv[1:7]
data = {}
try:
    data = json.load(open(path))
except Exception:
    pass
now = datetime.datetime.now(datetime.timezone.utc).isoformat()
data.update({"status": status, "message": message, "time": now})
if status == "success":
    data.update({"last_success": now, "last_file": name, "last_size": int(size), "last_duration": int(secs)})
tmp = path + ".tmp"
with open(tmp, "w") as fh:
    json.dump(data, fh)
os.chmod(tmp, 0o644)
os.replace(tmp, path)
PY
}

rclone_cmd() { rclone --config "$RCLONE_CONF" "$@"; }

backup_worker() {
  load_backup
  [ -s "$RCLONE_CONF" ] || { backup_status failed "Google Drive is not connected"; return 1; }
  [ -s "$BACKUP_KEY" ] || { backup_status failed "Set an encryption passphrase first"; return 1; }
  backup_status running "Backup in progress"
  local start name work paths dbname tar_status upload_status size
  start=$(date +%s)
  name="mailsomadhan-${MAIL_HOSTNAME}-$(date -u +%Y%m%d-%H%M%S).tar.gz.enc"
  work="$(mktemp -d /var/tmp/mailsomadhan-backup.XXXXXX)"
  trap 'rm -rf "$work"' RETURN
  echo "== backup $name started $(date -Is)"

  dbname="$(sed -n 's#^MAILSOMADHAN_DATABASE_URL=.*/\([A-Za-z0-9_]*\)$#\1#p' /etc/mailsomadhan/mailsomadhan.env)"
  dbname="${dbname:-mailsomadhan}"
  chown postgres "$work"
  if ! runuser -u postgres -- pg_dump -Fc -f "$work/database.dump" "$dbname"; then
    backup_status failed "Database dump failed"
    return 1
  fi
  chown root "$work"
  cat > "$work/backup-info.json" <<EOF
{"host": "$MAIL_HOSTNAME", "created": "$(date -Is)", "version": "$(cat /opt/mailsomadhan/src/VERSION 2>/dev/null || echo unknown)", "database": "$dbname", "includes_mail": $( [ "$BK_MAIL" = 1 ] && echo true || echo false )}
EOF
  paths=()
  for p in etc/mailsomadhan var/lib/mailsomadhan var/lib/rspamd/dkim etc/letsencrypt; do
    [ -e "/$p" ] && paths+=("$p")
  done
  [ "$BK_MAIL" = 1 ] && [ -d /var/vmail ] && paths+=("var/vmail")

  echo "== uploading to Google Drive folder $BK_FOLDER"
  set +e
  tar -cf - -C "$work" database.dump backup-info.json -C / --warning=no-file-changed "${paths[@]}" \
    | gzip -6 \
    | openssl enc -aes-256-cbc -pbkdf2 -iter 200000 -salt -pass "file:$BACKUP_KEY" \
    | rclone_cmd rcat "gdrive:$BK_FOLDER/$name"
  local statuses=("${PIPESTATUS[@]}")
  set -e
  tar_status=${statuses[0]}; upload_status=${statuses[3]}
  if [ "$tar_status" -gt 1 ] || [ "${statuses[1]}" != 0 ] || [ "${statuses[2]}" != 0 ] || [ "$upload_status" != 0 ]; then
    echo "== FAILED (tar=$tar_status gzip=${statuses[1]} openssl=${statuses[2]} upload=$upload_status)"
    rclone_cmd deletefile "gdrive:$BK_FOLDER/$name" >/dev/null 2>&1 || true
    backup_status failed "Upload to Google Drive failed. See the backup log."
    return 1
  fi
  size="$(rclone_cmd lsjson "gdrive:$BK_FOLDER/$name" 2>/dev/null | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d[0]["Size"] if d else 0)' || echo 0)"

  # Retention: keep the newest BK_KEEP backups of this server.
  rclone_cmd lsf --files-only "gdrive:$BK_FOLDER" 2>/dev/null \
    | grep -E "^mailsomadhan-${MAIL_HOSTNAME//./\\.}-[0-9]{8}-[0-9]{6}\.tar\.gz\.enc$" | sort -r \
    | tail -n +"$((BK_KEEP + 1))" | while IFS= read -r old; do
        echo "== removing old backup $old"
        rclone_cmd deletefile "gdrive:$BK_FOLDER/$old" || true
      done

  backup_status success "Backup uploaded" "$name" "$size" "$(( $(date +%s) - start ))"
  echo "== backup finished $(date -Is), $size bytes"
}

cmd="${1:-}"
shift || true

case "$cmd" in
  tls-sync)
    sync_tls
    echo "TLS configuration synchronised"
    ;;

  set-primary-host)
    host="${1:-}"
    valid_host "$host" || die "invalid hostname"
    list_hosts | grep -xF "$host" >/dev/null || die "unknown host: add it in the panel first"
    dir="$TLS_DIR/$host"
    if [ ! -f "$dir/fullchain.pem" ] || [ ! -f "$dir/privkey.pem" ]; then
      if [ -f "/etc/letsencrypt/live/$host/fullchain.pem" ]; then
        install -d -m 755 "$dir"
        install -m 644 "/etc/letsencrypt/live/$host/fullchain.pem" "$dir/fullchain.pem"
        install -m 600 "/etc/letsencrypt/live/$host/privkey.pem" "$dir/privkey.pem"
      else
        install -d -m 755 "$dir"
        openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
          -subj "/CN=$host" -addext "subjectAltName=DNS:$host" \
          -keyout "$dir/privkey.pem" -out "$dir/fullchain.pem" 2>/dev/null
        chmod 600 "$dir/privkey.pem"
        chmod 644 "$dir/fullchain.pem"
      fi
    fi
    MAIL_HOSTNAME="$host"
    for f in "$CONF" /etc/mailsomadhan/install.conf; do
      if [ -f "$f" ]; then
        sed -i '/^MAIL_HOSTNAME=/d' "$f"
        echo "MAIL_HOSTNAME='$host'" >> "$f"
      fi
    done
    if [ -f /etc/mailsomadhan/mailsomadhan.env ]; then
      sed -i '/^MAILSOMADHAN_PRIMARY_HOSTNAME=/d' /etc/mailsomadhan/mailsomadhan.env
      echo "MAILSOMADHAN_PRIMARY_HOSTNAME=$host" >> /etc/mailsomadhan/mailsomadhan.env
    fi
    postconf -e "myhostname = $host" "smtpd_tls_chain_files = $dir/privkey.pem, $dir/fullchain.pem"
    if [ -f /etc/dovecot/dovecot.conf ]; then
      sed -i "s#^ssl_cert = <.*#ssl_cert = <$dir/fullchain.pem#" /etc/dovecot/dovecot.conf
      sed -i "s#^ssl_key = <.*#ssl_key = <$dir/privkey.pem#" /etc/dovecot/dovecot.conf
      sed -i "s#^  postmaster_address = .*#  postmaster_address = postmaster@$host#" /etc/dovecot/dovecot.conf
    fi
    sync_tls
    echo "primary host set to $host"
    ;;

  set-web-port)
    port="${1:-}"
    [[ "$port" =~ ^[0-9]{1,5}$ ]] && [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || die "invalid port"
    [ "$port" != "$HTTP_PORT" ] || die "panel port cannot be the same as HTTP port ($HTTP_PORT)"
    case " 25 465 587 993 10025 10143 11332 11334 5432 6379 18080 13000 " in
      *" $port "*) die "port $port is reserved for mail or internal services" ;;
    esac
    if [ "$port" != "$WEB_PORT" ]; then
      if ss -ltnH 2>/dev/null | awk '{print $4}' | grep -qE "[:.]$port$"; then
        die "port $port is already in use by another program"
      fi
    fi
    WEB_PORT="$port"
    for f in "$CONF" /etc/mailsomadhan/install.conf; do
      if [ -f "$f" ]; then
        sed -i '/^WEB_PORT=/d' "$f"
        echo "WEB_PORT='$port'" >> "$f"
      fi
    done
    if [ -f /etc/mailsomadhan/mailsomadhan.env ]; then
      sed -i '/^MAILSOMADHAN_WEB_PORT=/d' /etc/mailsomadhan/mailsomadhan.env
      echo "MAILSOMADHAN_WEB_PORT=$port" >> /etc/mailsomadhan/mailsomadhan.env
    fi
    if [ -f /etc/fail2ban/jail.d/mailsomadhan.local ]; then
      sed -i "s/^port = .*/port = $port/" /etc/fail2ban/jail.d/mailsomadhan.local
      systemctl reload fail2ban 2>/dev/null || true
    fi
    if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q '^Status: active'; then
      ufw allow "$port/tcp" >/dev/null 2>&1 || true
    fi
    sync_tls
    echo "panel port set to $port"
    ;;

  tls-start)
    # tls-start <http|dns|cloudflare> <host> [email]: issue a certificate in the background.
    method="${1:-}"; host="${2:-}"; email="${3:-}"
    [[ "$method" =~ ^(http|dns|cloudflare)$ ]] || die "invalid method"
    valid_host "$host" || die "invalid hostname"
    list_hosts | grep -xF "$host" >/dev/null || die "unknown host: add it in the panel first"
    [ -z "$email" ] || [[ "$email" =~ $EMAIL_RE ]] || die "invalid contact email"
    if [ "$method" = cloudflare ] && [ ! -s "$CF_INI" ]; then die "add a Cloudflare API token first"; fi
    if systemctl is-active -q mailsomadhan-tls 2>/dev/null; then die "another certificate request is running"; fi
    systemctl reset-failed mailsomadhan-tls 2>/dev/null || true
    rm -f "$TLS_FLAG" "$TLS_JOB"
    install -m 640 -g mailsomadhan /dev/null "$TLS_LOG"
    tls_state host="$host" method="$method" state=running message="Starting"
    systemd-run --quiet --unit=mailsomadhan-tls --description="MailSomadhan certificate request" --collect \
      --setenv=MAILSOMADHAN_TLS_JOB=1 \
      --property=StandardOutput=append:"$TLS_LOG" --property=StandardError=append:"$TLS_LOG" \
      /usr/local/sbin/mailsomadhan-helper tls-worker "$method" "$host" "$email"
    echo "certificate request started"
    ;;
  tls-worker)
    method="${1:-}"; host="${2:-}"; email="${3:-}"
    [[ "$method" =~ ^(http|dns|cloudflare)$ ]] && valid_host "$host" || die "invalid arguments"
    args=(certonly --non-interactive --agree-tos --cert-name "$host" -d "$host" --force-renewal)
    if [ -n "$email" ] && [[ "$email" =~ $EMAIL_RE ]]; then args+=(-m "$email" --no-eff-email); else args+=(--register-unsafely-without-email); fi
    case "$method" in
      http)
        mkdir -p "$ACME_ROOT"
        args+=(--webroot -w "$ACME_ROOT") ;;
      dns)
        args+=(--manual --preferred-challenges dns
               --manual-auth-hook "/usr/local/sbin/mailsomadhan-helper tls-dns-auth"
               --manual-cleanup-hook "/usr/local/sbin/mailsomadhan-helper tls-dns-cleanup") ;;
      cloudflare)
        args+=(--authenticator dns-cloudflare --dns-cloudflare-credentials "$CF_INI"
               --dns-cloudflare-propagation-seconds 30) ;;
    esac
    tls_state state=running message="Requesting the certificate from Let's Encrypt"
    if certbot "${args[@]}"; then
      sync_tls
      tls_state state=done message="Trusted certificate installed"
    else
      tls_state state=failed message="$(grep -E 'Detail:|Error|error:|Type:|Hint:' "$TLS_LOG" | tail -n 6 | cut -c1-300 | tr '\n' ' ')"
      exit 1
    fi
    ;;
  tls-dns-auth)
    # certbot manual hook: show the TXT record in the panel and wait until the admin says it is published.
    if [ "${MAILSOMADHAN_TLS_JOB:-}" != 1 ]; then
      echo "This certificate was issued with a manual DNS record: renew it from the panel." >&2
      exit 1
    fi
    valid_host "${CERTBOT_DOMAIN:-}" || die "invalid domain"
    [[ "${CERTBOT_VALIDATION:-}" =~ ^[A-Za-z0-9_-]{20,200}$ ]] || die "invalid validation value"
    rm -f "$TLS_FLAG"
    tls_state state=waiting_dns record="_acme-challenge.$CERTBOT_DOMAIN" value="$CERTBOT_VALIDATION" \
      message="Add the TXT record, then press Verify"
    for _ in $(seq 1 1800); do   # up to one hour
      if [ -f "$TLS_FLAG" ]; then
        rm -f "$TLS_FLAG"
        tls_state state=running message="Let's Encrypt is checking the DNS record"
        exit 0
      fi
      sleep 2
    done
    tls_state state=failed message="Timed out waiting for the DNS record"
    exit 1
    ;;
  tls-dns-cleanup)
    rm -f "$TLS_FLAG"
    ;;
  tls-continue)
    [ -f "$TLS_JOB" ] && grep -q '"state": "waiting_dns"' "$TLS_JOB" || die "no certificate request is waiting"
    touch "$TLS_FLAG"
    echo "continuing"
    ;;
  tls-cancel)
    systemctl stop mailsomadhan-tls 2>/dev/null || true
    rm -f "$TLS_FLAG"
    tls_state state=cancelled message="Cancelled"
    echo "cancelled"
    ;;
  tls-cloudflare-token)
    # Token on stdin (never on the command line). Needs the "Edit zone DNS" permission.
    token="$(head -c 300 | tr -d '[:space:]')"
    [[ "$token" =~ ^[A-Za-z0-9_-]{30,200}$ ]] || die "this does not look like a Cloudflare API token"
    zones="$(printf '%s' "$token" | python3 /usr/local/sbin/mailsomadhan-cloudflare verify)" || exit 1
    ( umask 077; printf 'dns_cloudflare_api_token = %s\n' "$token" > "$CF_INI" )
    python3 - "$CF_STATE" "…${token: -4}" "$zones" <<'PY'
import datetime, json, os, sys
path, hint, zones = sys.argv[1:4]
data = {"configured": True, "hint": hint, "zones": json.loads(zones).get("zones", []),
        "time": datetime.datetime.now(datetime.timezone.utc).isoformat()}
with open(path + ".tmp", "w") as fh:
    json.dump(data, fh)
os.chmod(path + ".tmp", 0o644)
os.replace(path + ".tmp", path)
PY
    echo "saved"
    ;;
  cf-dns-lookup|cf-dns-apply)
    # cf-dns-lookup|cf-dns-apply <domain> <dkim selector>; apply reads the change list on stdin.
    domain="${1:-}"; selector="${2:-}"
    valid_host "$domain" && [[ "$selector" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || die "invalid arguments"
    [ -s "$CF_INI" ] || die "connect Cloudflare first"
    exec python3 /usr/local/sbin/mailsomadhan-cloudflare "${cmd#cf-dns-}" "$domain" "$selector"
    ;;
  cf-host-lookup|cf-host-apply)
    # cf-host-lookup|cf-host-apply <hostname>: A / AAAA of one of this server's hostnames.
    host="${1:-}"
    valid_host "$host" || die "invalid hostname"
    [ "$host" = "$MAIL_HOSTNAME" ] || list_hosts | grep -xF "$host" >/dev/null || die "unknown host: add it in the panel first"
    [ -s "$CF_INI" ] || die "connect Cloudflare first"
    exec python3 /usr/local/sbin/mailsomadhan-cloudflare "host-${cmd#cf-host-}" "$host"
    ;;
  tls-cloudflare-remove)
    rm -f "$CF_INI" "$CF_STATE"
    echo "removed"
    ;;
  tls-issue)
    host="${1:-}"
    email="${2:-}"
    valid_host "$host" || die "invalid hostname"
    list_hosts | grep -xF "$host" >/dev/null || die "unknown host: add it in the panel first"
    args=(certonly --webroot -w "$ACME_ROOT" -d "$host" --non-interactive --agree-tos --keep-until-expiring)
    if [ -n "$email" ]; then
      [[ "$email" =~ $EMAIL_RE ]] || die "invalid contact email"
      args+=(-m "$email" --no-eff-email)
    else
      args+=(--register-unsafely-without-email)
    fi
    mkdir -p "$ACME_ROOT"
    certbot "${args[@]}"
    sync_tls
    echo "certificate installed for $host"
    ;;

  purge-mailbox)
    email="${1:-}"
    [[ "$email" =~ $EMAIL_RE ]] || die "invalid address"
    target="$MAIL_DIR/${email#*@}/${email%@*}"
    case "$target" in *..*) die "invalid address" ;; esac
    if [ -d "$target" ]; then rm -rf -- "$target"; fi
    echo "mail storage removed for $email"
    ;;

  purge-domain)
    domain="${1:-}"
    valid_host "$domain" || die "invalid domain"
    if [ -d "$MAIL_DIR/$domain" ]; then rm -rf -- "${MAIL_DIR:?}/$domain"; fi
    echo "mail storage removed for $domain"
    ;;

  set-message-size)
    size="${1:-}"
    [[ "$size" =~ ^[0-9]{6,10}$ ]] || die "invalid size"
    [ "$size" -ge 1048576 ] && [ "$size" -le 524288000 ] || die "size out of range"
    postconf -e "message_size_limit=$size"
    systemctl reload postfix
    echo "message size limit set to $size bytes"
    ;;

  queue-flush)
    postqueue -f
    ;;

  queue-delete)
    id="${1:-}"
    [[ "$id" =~ ^[A-Za-z0-9]{5,20}$ ]] || die "invalid queue id"
    postsuper -d "$id"
    ;;

  set-features)
    load_features
    for arg in "$@"; do
      key="${arg%%=*}"; value="${arg#*=}"
      case "$key" in
        spam)     [[ "$value" =~ ^[01]$ ]] || die "invalid spam value";     SPAM_FILTER="$value" ;;
        redis)    [[ "$value" =~ ^[01]$ ]] || die "invalid redis value";    REDIS="$value" ;;
        greylist) [[ "$value" =~ ^[01]$ ]] || die "invalid greylist value"; GREYLIST="$value" ;;
        junk)     [[ "$value" =~ $NUM_RE ]] || die "invalid junk score";    JUNK_SCORE="$value" ;;
        reject)   [[ "$value" =~ $NUM_RE ]] || die "invalid reject score";  REJECT_SCORE="$value" ;;
        subjects) [[ "$value" =~ ^[01]$ ]] || die "invalid subjects value"; TRACK_SUBJECTS="$value" ;;
        *) die "unknown setting" ;;
      esac
    done
    awk -v j="$JUNK_SCORE" -v r="$REJECT_SCORE" 'BEGIN { exit !(j >= 1 && r > j && r <= 200) }' \
      || die "scores must satisfy 1 <= junk < reject <= 200"
    save_features
    apply_features
    echo "features applied"
    ;;

  quota-usage)
    # Used storage per mailbox (KiB), for the admin console.
    doveadm -f tab quota get -A 2>/dev/null | awk -F'\t' 'NR > 1 && $3 == "STORAGE" { print $1 "\t" $2 "\t" $3 "\t" $4 "\t" $5 }'
    ;;

  sync-milter)
    sync_milter
    echo "milter synchronised"
    ;;

  apply-features)
    [ -f "$FEATURES" ] || { load_features; save_features; }
    apply_features
    echo "features applied"
    ;;

  update-check)
    update_check
    ;;

  service-restart)
    # Only MailSomadhan's own services and the mail stack; never the database or other programs.
    svc="${1:-}"
    case " postfix dovecot rspamd redis-server nginx fail2ban mailsomadhan-api mailsomadhan-web mailsomadhan-collector mailsomadhan-campaigns " in
      *" $svc "*) [ -n "$svc" ] || die "missing service" ;;
      *) die "this service cannot be restarted from the panel" ;;
    esac
    if [ "$svc" = mailsomadhan-api ] || [ "$svc" = mailsomadhan-web ]; then
      # The panel itself: restart a moment later so this request can still answer.
      systemd-run --quiet --collect --on-active=2 /usr/bin/systemctl restart "$svc"
    else
      systemctl restart "$svc"
    fi
    echo "restarted $svc"
    ;;

  update-start)
    if systemctl is-active -q mailsomadhan-update 2>/dev/null; then die "an update is already running"; fi
    systemctl reset-failed mailsomadhan-update 2>/dev/null || true
    install -m 640 -g mailsomadhan /dev/null "$UPDATE_LOG"
    write_result running "Update starting"
    systemd-run --quiet --unit=mailsomadhan-update --description="MailSomadhan update" --collect \
      --setenv=HOME=/root --setenv=DEBIAN_FRONTEND=noninteractive \
      --property=StandardOutput=append:"$UPDATE_LOG" --property=StandardError=append:"$UPDATE_LOG" \
      /usr/local/sbin/mailsomadhan-helper update-worker
    echo "update started"
    ;;

  backup-configure)
    load_backup
    for arg in "$@"; do
      key="${arg%%=*}"; value="${arg#*=}"
      case "$key" in
        enabled)  [[ "$value" =~ ^[01]$ ]] || die "invalid value"; BK_ENABLED="$value" ;;
        interval) [[ "$BACKUP_INTERVALS" == *" $value "* ]] || die "invalid interval"; BK_INTERVAL="$value" ;;
        hour)     [[ "$value" =~ ^([0-9]|1[0-9]|2[0-3])$ ]] || die "invalid hour"; BK_HOUR="$value" ;;
        keep)     [[ "$value" =~ ^[0-9]{1,3}$ ]] && [ "$value" -ge 1 ] || die "invalid keep"; BK_KEEP="$value" ;;
        mail)     [[ "$value" =~ ^[01]$ ]] || die "invalid value"; BK_MAIL="$value" ;;
        folder)   [[ "$value" =~ ^[A-Za-z0-9._-]{1,100}$ ]] || die "invalid folder name"; BK_FOLDER="$value" ;;
        *) die "unknown setting" ;;
      esac
    done
    if [ "$BK_ENABLED" = 1 ] && { [ ! -s "$RCLONE_CONF" ] || [ ! -s "$BACKUP_KEY" ]; }; then
      die "connect Google Drive and set a passphrase before enabling scheduled backups"
    fi
    save_backup
    write_backup_timer
    echo "backup settings saved"
    ;;

  backup-credentials)
    # JSON on stdin: {"mode": "oauth", "token": "...", "client_id": "", "client_secret": "", "shared_drive_id": "",
    #                 "scope": "drive" | "drive.file"}
    #            or {"mode": "service_account", "service_account": "...", "shared_drive_id": "..."}
    load_backup
    umask 077
    payload="$(head -c 200000)"
    mode="$(printf '%s' "$payload" | python3 -c '
import json, re, sys
d = json.load(sys.stdin)
mode = d.get("mode")
sd = (d.get("shared_drive_id") or "").strip()
if sd and not re.fullmatch(r"[A-Za-z0-9_-]{5,100}", sd):
    sys.exit("invalid shared drive id")
scope = d.get("scope") or "drive"
if scope not in ("drive", "drive.file"):
    sys.exit("invalid scope")
lines = ["[gdrive]", "type = drive", "scope = " + scope]
if mode == "oauth":
    tok = json.loads(d.get("token") or "")
    if not isinstance(tok, dict) or "refresh_token" not in tok:
        sys.exit("the token must be the JSON printed by: rclone authorize \"drive\"")
    cid, sec = (d.get("client_id") or "").strip(), (d.get("client_secret") or "").strip()
    for v in (cid, sec):
        if v and not re.fullmatch(r"[A-Za-z0-9._-]{5,200}", v):
            sys.exit("invalid client id or secret")
    if cid:
        lines += ["client_id = " + cid, "client_secret = " + sec]
    lines.append("token = " + json.dumps(tok, separators=(",", ":")))
elif mode == "service_account":
    sa = json.loads(d.get("service_account") or "")
    if not isinstance(sa, dict) or sa.get("type") != "service_account" or "private_key" not in sa:
        sys.exit("this is not a Google service account key file")
    if not sd:
        sys.exit("a service account needs a Shared drive ID")
    open("/etc/mailsomadhan/gdrive-service-account.json", "w").write(json.dumps(sa))
    lines.append("service_account_file = /etc/mailsomadhan/gdrive-service-account.json")
else:
    sys.exit("unknown mode")
if sd:
    lines.append("team_drive = " + sd)
open("/etc/mailsomadhan/rclone.conf", "w").write("\n".join(lines) + "\n")
print(mode)
')" || die "invalid credentials"
    chmod 600 "$RCLONE_CONF" "$GDRIVE_SA" 2>/dev/null || true
    BK_MODE="$mode"
    save_backup
    echo "credentials saved"
    ;;

  backup-disconnect)
    load_backup
    rm -f "$RCLONE_CONF" "$GDRIVE_SA"
    BK_MODE=""; BK_ENABLED=0
    save_backup
    write_backup_timer
    echo "disconnected"
    ;;

  backup-passphrase)
    load_backup
    umask 077
    pass="$(head -c 1000)"
    [ "${#pass}" -ge 12 ] || die "the passphrase must be at least 12 characters"
    printf '%s' "$pass" > "$BACKUP_KEY"
    chmod 600 "$BACKUP_KEY"
    save_backup
    echo "passphrase saved"
    ;;

  backup-test)
    load_backup
    [ -s "$RCLONE_CONF" ] || die "Google Drive is not connected"
    rclone_cmd mkdir "gdrive:$BK_FOLDER"
    rclone_cmd lsf --max-depth 1 "gdrive:$BK_FOLDER" >/dev/null
    echo "connection ok"
    ;;

  backup-list)
    load_backup
    [ -s "$RCLONE_CONF" ] || { echo "[]"; exit 0; }
    rclone_cmd lsjson --files-only "gdrive:$BK_FOLDER" 2>/dev/null | python3 -c '
import json, sys
items = [{"name": x["Name"], "size": x["Size"], "time": x["ModTime"]} for x in json.load(sys.stdin)
         if x["Name"].startswith("mailsomadhan-") and x["Name"].endswith(".tar.gz.enc")]
print(json.dumps(sorted(items, key=lambda x: x["name"], reverse=True)))
'
    ;;

  backup-start)
    load_backup
    [ -s "$RCLONE_CONF" ] || die "connect Google Drive first"
    [ -s "$BACKUP_KEY" ] || die "set an encryption passphrase first"
    if systemctl is-active -q mailsomadhan-backup.service 2>/dev/null; then die "a backup is already running"; fi
    [ -f /etc/systemd/system/mailsomadhan-backup.service ] || write_backup_timer
    install -m 640 -g mailsomadhan /dev/null "$BACKUP_LOG"
    backup_status running "Backup starting"
    systemctl start --no-block mailsomadhan-backup.service
    echo "backup started"
    ;;

  backup-worker)
    exec >>"$BACKUP_LOG" 2>&1
    backup_worker
    exit $?
    ;;

  update-worker)
    # Only meaningful inside the mailsomadhan-update unit started above (or from the CLI as root).
    update_worker
    exit $?
    ;;

  *)
    die "unknown command"
    ;;
esac
exit 0
