#!/usr/bin/env bash
# MailSomadhan management command.
set -euo pipefail

APP_DIR=/opt/mailsomadhan
SRC_DIR=$APP_DIR/src
ENV_FILE=/etc/mailsomadhan/mailsomadhan.env
SERVICES=(postfix dovecot rspamd redis-server postgresql nginx fail2ban mailsomadhan-api mailsomadhan-web mailsomadhan-collector mailsomadhan-campaigns)

need_root() {
  [ "$(id -u)" -eq 0 ] || { echo "Run this command as root (sudo mailsomadhan $*)" >&2; exit 1; }
}

cli() {
  (cd "$SRC_DIR/backend" && sudo -u mailsomadhan env MAILSOMADHAN_ENV_FILE="$ENV_FILE" "$APP_DIR/venv/bin/python" -m app.cli "$@")
}

case "${1:-help}" in
  status)
    for s in "${SERVICES[@]}"; do
      printf '  %-16s %s\n' "$s" "$(systemctl is-active "$s" 2>/dev/null || true)"
    done
    ;;
  info)
    need_root info
    # shellcheck disable=SC1091
    . /etc/mailsomadhan/helper.conf
    echo "Panel:     https://$MAIL_HOSTNAME:$WEB_PORT"
    echo "Mail host: $MAIL_HOSTNAME  (SMTP 25/465/587, IMAP 993)"
    echo "Initial credentials: /root/mailsomadhan-credentials.txt"
    ;;
  restart)
    need_root restart
    systemctl restart "${SERVICES[@]}"
    echo "All services restarted"
    ;;
  logs)
    journalctl -u mailsomadhan-api -u mailsomadhan-web -u postfix@- -u dovecot -u rspamd -n "${2:-100}" --no-pager
    ;;
  reset-admin-password)
    need_root reset-admin-password
    password="$(openssl rand -base64 18 | tr -d '/+=' | cut -c1-20)"
    cli reset-admin --password "$password"
    echo "New password for 'admin': $password"
    ;;
  update)
    need_root update
    # Same path as the "Update now" button in the panel: runs detached, so a dropped SSH
    # session cannot interrupt it half-way.
    /usr/local/sbin/mailsomadhan-helper update-start
    sleep 1
    pid="$(systemctl show -p MainPID --value mailsomadhan-update 2>/dev/null || echo 0)"
    if [ "${pid:-0}" != 0 ]; then
      tail -n +1 -f --pid="$pid" /var/log/mailsomadhan-update.log
    else
      cat /var/log/mailsomadhan-update.log
    fi
    cat /var/lib/mailsomadhan/update-result.json; echo
    ;;
  *)
    cat <<EOF
Usage: mailsomadhan <command>

  status                 show the state of every service
  info                   show the panel address and mail ports
  restart                restart every service
  logs [lines]           show recent log output
  reset-admin-password   generate a new password for the admin user
  update                 pull the latest version and re-apply the installation
EOF
    ;;
esac
